# ---- Database ----
POSTGRES_USER=surau
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=pemuda_surau

# ---- API ----
# JWT_SECRET is generated automatically on the server (see deploy/sync.bat).
# For local development, set any value here, e.g. run:  openssl rand -hex 32
JWT_EXPIRES_IN=30d

# Face matching: lower = stricter. 0.5-0.6 is a good range for face-api.js descriptors.
FACE_MATCH_THRESHOLD=0.55

# ---- Prayer times (automatic check-in windows) ----
# Times are fetched from the Aladhan API and cached per day.
PRAYER_LATITUDE=2.93276
PRAYER_LONGITUDE=101.8047
PRAYER_TIMEZONE=Asia/Kuala_Lumpur
# Aladhan calculation method id. 17 = JAKIM (Malaysia).
PRAYER_CALC_METHOD=17
# Check-in window: opens N minutes before the adhan, closes M minutes after.
PRAYER_WINDOW_BEFORE_MINUTES=15
PRAYER_WINDOW_AFTER_MINUTES=60
# When false, the client may pick any prayer (legacy behaviour).
PRAYER_WINDOW_ENFORCED=true

# OTP
OTP_TTL_MINUTES=5

# How login codes are delivered: telegram | sms | console
#   telegram = free, requires TELEGRAM_BOT_TOKEN + users linking their account
#   sms      = paid, uses SMS_PROVIDER below
#   console  = logs codes to the server (dev only)
OTP_CHANNEL=telegram

# ---- Telegram (free OTP delivery) ----
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Set the bot username (without @)
# The server long-polls Telegram for updates, so no public URL or webhook is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Long-poll duration in seconds
TELEGRAM_POLL_TIMEOUT=30

# Public base URL of the app (optional; shown in links)
# e.g. https://surau.example.com
PUBLIC_URL=

# SMS provider: console | twilio | vonage (only used when OTP_CHANNEL=sms)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# Comma separated list of phone numbers that get admin rights on first login
ADMIN_PHONES=+60123456789

# CORS origin for the API (set to your public domain in production)
CORS_ORIGIN=*

# ---- Web ----
# Local bind address for the web container. Keep 127.0.0.1 when using the
# Cloudflare Tunnel so the app is only reachable through Cloudflare.
WEB_BIND=127.0.0.1
WEB_PORT=8080
VITE_API_BASE_URL=/api

# ---- Cloudflare Quick Tunnel ----
# The stack runs a free Cloudflare Quick Tunnel (service `quicktunnel`) that gives a
# random https://<words>.trycloudflare.com URL. No account, domain, or token needed.
# Read the URL with:  docker compose logs quicktunnel | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com'
